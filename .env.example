# ─────────────────────────────────────────────────────────────────────────────
#  Los Juegos de la Ceniza — variables de entorno
#  Copia este archivo como /etc/ceniza/ceniza.env (producción) o .env (desarrollo).
#  NUNCA subas el archivo real a un repositorio.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Dirección y puerto internos del servidor Node (el proxy o el túnel apuntan aquí).
HOST=127.0.0.1
PORT=3000

# PostgreSQL local de la VM. Cambia la contraseña (install.sh genera una aleatoria).
DATABASE_URL=postgres://ceniza:CAMBIA_ESTA_CONTRASEÑA@127.0.0.1:5432/ceniza

# Nombre visible del juego.
APP_NAME="Los Juegos de la Ceniza"

# URL pública por la que entran tus amigos (se usa para enlaces de invitación y control de origen).
PUBLIC_URL=https://juegos.example.com

# Sesiones: días que se recuerda el inicio de sesión en el mismo navegador.
SESSION_TTL_DAYS=30

# Cookie segura: auto = solo si la petición llega por HTTPS (recomendado detrás de Caddy o Cloudflare).
COOKIE_SECURE=auto

# Confiar en las cabeceras X-Forwarded-* del proxy local (Caddy o cloudflared en la misma VM).
TRUST_PROXY=loopback

# Fotos de usuario (fuera del código, en un disco persistente con copias de seguridad).
UPLOAD_DIR=/var/lib/ceniza/uploads
MAX_UPLOAD_MB=12
MAX_PHOTOS_PER_USER=40
MAX_TEMPLATES_PER_USER=30

# Opcional: si lo defines, hará falta este código para registrarse (útil si el juego está en Internet).
REGISTRATION_CODE=

# Usuarios que serán administradores al entrar (separados por comas). El primer registrado también lo es.
ADMIN_USERNAMES=

# Node sirve el frontend compilado (true) o lo sirve Caddy (false).
SERVE_STATIC=true
STATIC_DIR=/opt/ceniza/app/apps/web/dist

# fatal | error | warn | info | debug
LOG_LEVEL=info

# Orígenes adicionales permitidos (separados por comas), p. ej. http://192.168.1.50:3000 para pruebas en LAN.
EXTRA_ALLOWED_ORIGINS=

# Tiempos de partida en milisegundos (opcional; estos son los valores por defecto)
# MATCH_LOBBY_COUNTDOWN_MS=5000
# MATCH_PRESENTATION_MS=8000
# MATCH_COUNTDOWN_MS=15000
# MATCH_SNAPSHOT_MS=10000
